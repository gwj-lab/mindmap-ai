{
  "name": "mindmap-ai",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first AI answer capture and mind mapping workspace",
  "packageManager": "pnpm@11.25.0",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0"
  },
  "build": {
    "appId": "com.mindmapai.desktop",
    "productName": "Mindmap AI",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "artifactName": "Mindmap-AI-${version}-${arch}.${ext}",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@uiw/react-codemirror": "^4.25.4",
    "flexlayout-react": "0.10.5",
    "katex": "0.18.4",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "simple-mind-map": "0.14.0-fix.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "write-file-atomic": "8.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.48.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
