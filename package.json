    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "simple-mind-map": "0.14.0-fix.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
